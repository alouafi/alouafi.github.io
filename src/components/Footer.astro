---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="footer-links">
    <a href={profile.links.linkedin} rel="me noreferrer">
      LinkedIn
    </a>
    <a href={profile.links.github} rel="me noreferrer">
      GitHub
    </a>
    <a href={profile.links.letterboxd} rel="me noreferrer">
      Letterboxd
    </a>
    <a href="/rss.xml">RSS</a>
  </p>
  <p class="footer-credit">
    <a href="https://www.themoviedb.org" rel="noreferrer">
      <img
        src="/assets/img/tmdb.svg"
        alt="TMDB"
        width="84"
        height="11"
        loading="lazy"
      />
    </a>
    Film posters and stills come from TMDB. This product uses the TMDB API but
    is not endorsed or certified by TMDB.
  </p>
  <p class="footer-copy">
    © {year} {profile.name}, Paris
  </p>
</footer>
