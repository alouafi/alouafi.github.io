---
import {
  getPublishedPosts,
  topicHref,
  topicPages,
  type Section,
} from "../lib/posts";

interface Props {
  current?: Section | undefined;
}

const { current } = Astro.props;
// Topics without published posts stay out of the menu.
const posts = await getPublishedPosts();
const hasPosts = (topic: keyof typeof topicPages) =>
  posts.some((post) => post.data.topic === topic);
const items = [
  { key: "cinema", href: topicHref("cinema"), label: topicPages.cinema.label },
  { key: "reviews", href: "/reviews/", label: "Reviews" },
  // Phones show the short label so the menu fits on one row.
  { key: "cannes", href: "/cannes/", label: "Cannes", long: "Film Festival" },
  { key: "tech", href: topicHref("tech"), label: topicPages.tech.label },
  ...(hasPosts("notes")
    ? [
        {
          key: "notes",
          href: topicHref("notes"),
          label: topicPages.notes.label,
        },
      ]
    : []),
];
---

<header class="site-header">
  <a
    class="site-name"
    href="/"
    aria-current={current === "home" ? "page" : undefined}
  >
    <img
      class="seal"
      src="/assets/img/seal.svg"
      alt=""
      width="36"
      height="36"
    />
    <span>Aïmen Louafi</span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    {items.map(({ key, href, label, long }) => (
      <a href={href} aria-current={current === key ? "page" : undefined}>
        {label}
        {long && <span class="nav-long">&nbsp;{long}</span>}
      </a>
    ))}
  </nav>
</header>
