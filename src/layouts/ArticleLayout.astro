---
import BaseLayout from "./BaseLayout.astro";
import { topicHref, topicPages, type Section, type Topic } from "../lib/posts";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  language: "en" | "fr";
  topic: Topic;
  minutes?: number;
  cover?: { src: string; alt: string } | undefined;
  // Overrides for pages that are not posts, such as imported reviews.
  deck?: string | null | undefined;
  details?: { value: string; spoken?: string }[] | undefined;
  back?: { href: string; label: string } | undefined;
  section?: Section | undefined;
}

const {
  title,
  description,
  publishedAt,
  language,
  topic,
  minutes,
  cover,
  deck = description,
  details = [],
  back = { href: topicHref(topic), label: topicPages[topic].label },
  section = topic,
} = Astro.props;
const french = language === "fr";
const date = publishedAt.toLocaleDateString(french ? "fr-FR" : "en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title={`${title} — Aïmen Louafi`}
  {description}
  current={section}
  image={cover?.src}
  imageAlt={cover?.alt}
  article
  lang={language}
>
  <main class="page" id="main">
    <header class="article-header">
      <p class="article-kicker">
        <a href={back.href}>{back.label}</a>
      </p>
      <h1>{title}</h1>
      {deck && <p class="article-deck">{deck}</p>}
      <p class="article-meta">
        <time datetime={publishedAt.toISOString()}>{date}</time>
        {details.map(({ value, spoken }) => (
          <>
            <span aria-hidden="true"> · </span>
            {spoken ? (
              <>
                <span aria-hidden="true">{value}</span>
                <span class="visually-hidden">{spoken}</span>
              </>
            ) : (
              <span>{value}</span>
            )}
          </>
        ))}
        {minutes && (
          <>
            <span aria-hidden="true"> · </span>
            {minutes} {french ? "min de lecture" : "min read"}
          </>
        )}
      </p>
    </header>
    <slot name="lead" />
    <article class="article-body">
      <slot />
    </article>
    <footer class="article-footer">
      <a href={back.href}>
        <span class="arrow arrow-back" aria-hidden="true">
          ←
        </span>
        {back.label}
      </a>
    </footer>
  </main>
</BaseLayout>
