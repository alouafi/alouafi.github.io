---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  language: "en" | "fr";
  topic: "tech" | "cinema" | "notes";
  format: "post" | "paper";
  minutes?: number;
}

const { title, description, publishedAt, language, topic, format, minutes } =
  Astro.props;
const locale = language === "fr" ? "fr-FR" : "en-GB";
const languageLabel = language === "fr" ? "Français" : "English";
const topicLabels = {
  tech: "Technology",
  cinema: "Cinema",
  notes: "Notes",
} as const;
const topicHashes = {
  tech: "work",
  cinema: "cinema",
  notes: "other",
} as const;
---

<BaseLayout
  title={`${title} — Aïmen Louafi`}
  {description}
  current="writing"
  article
  lang={language}
>
  <div class="reel-progress" aria-hidden="true"></div>
  <main class="article-shell" id="main">
    <header class="article-header reveal">
      <p class="eyebrow">
        {topicLabels[topic]} · {format === "paper" ? "Paper" : "Essay"}
      </p>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <dl class="article-meta">
        <div>
          <dt>Released</dt>
          <dd>
            <time datetime={publishedAt.toISOString()}>
              {publishedAt.toLocaleDateString(locale, {
                day: "2-digit",
                month: "long",
                year: "numeric",
              })}
            </time>
          </dd>
        </div>
        <div>
          <dt>Language</dt>
          <dd>{languageLabel}</dd>
        </div>
        {minutes && (
          <div>
            <dt>Runtime</dt>
            <dd>{minutes} min</dd>
          </div>
        )}
      </dl>
    </header>
    <article class="article-body">
      <slot />
    </article>
    <footer class="article-footer">
      <a class="text-link" href={`/writing/#${topicHashes[topic]}`}>
        <span aria-hidden="true">←</span> All writing
      </a>
      <p class="fin" aria-hidden="true">
        Fin
      </p>
      <a class="text-link" href="#main">
        Top <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </main>
</BaseLayout>
