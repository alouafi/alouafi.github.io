---
import BaseLayout from "./BaseLayout.astro";
import { topicHref, topicPages, type Topic } from "../lib/posts";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  language: "en" | "fr";
  topic: Topic;
  format: "post" | "paper";
  minutes?: number;
  cover?: { src: string; alt: string } | undefined;
}

const {
  title,
  description,
  publishedAt,
  language,
  topic,
  format,
  minutes,
  cover,
} = Astro.props;
const locale = language === "fr" ? "fr-FR" : "en-GB";
const languageLabel = language === "fr" ? "Français" : "English";
---

<BaseLayout
  title={`${title} — Aïmen Louafi`}
  {description}
  current={topic}
  image={cover?.src}
  imageAlt={cover?.alt}
  article
  lang={language}
>
  <div class="reel-progress" aria-hidden="true"></div>
  <main class="article-shell" id="main">
    <header class="article-header reveal">
      <p class="eyebrow">
        {topicPages[topic].label} · {format === "paper" ? "Paper" : "Essay"}
      </p>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <dl class="article-meta">
        <div>
          <dt>Released</dt>
          <dd>
            <time datetime={publishedAt.toISOString()}>
              {publishedAt.toLocaleDateString(locale, {
                day: "2-digit",
                month: "long",
                year: "numeric",
              })}
            </time>
          </dd>
        </div>
        <div>
          <dt>Language</dt>
          <dd>{languageLabel}</dd>
        </div>
        {minutes && (
          <div>
            <dt>Runtime</dt>
            <dd>{minutes} min</dd>
          </div>
        )}
      </dl>
    </header>
    <article class="article-body">
      <slot />
    </article>
    <footer class="article-footer">
      <a class="text-link" href={topicHref(topic)}>
        <span aria-hidden="true">←</span> {topicPages[topic].label}
      </a>
      <p class="fin" aria-hidden="true">
        Fin
      </p>
      <a class="text-link" href="#main">
        Top <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </main>
</BaseLayout>
