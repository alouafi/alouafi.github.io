---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  language: "en" | "fr";
  topic: "tech" | "cinema" | "notes";
  format: "post" | "paper";
}

const { title, description, publishedAt, language, topic, format } =
  Astro.props;
const locale = language === "fr" ? "fr-FR" : "en-GB";
const languageLabel = language === "fr" ? "Français" : "English";
const topicLabels = {
  tech: "Technology",
  cinema: "Cinema",
  notes: "Notes",
} as const;
---

<BaseLayout
  title={`${title} — Aïmen Louafi`}
  {description}
  current="writing"
  article
  lang={language}
>
  <main class="article-shell" id="main">
    <header class="article-header reveal">
      <p class="eyebrow">{topicLabels[topic]}</p>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <div class="article-meta">
        <time datetime={publishedAt.toISOString()}>
          {publishedAt.toLocaleDateString(locale, {
            day: "2-digit",
            month: "long",
            year: "numeric",
          })}
        </time>
        <span>{languageLabel}</span>
        <span>{format === "paper" ? "Paper" : "Internal"}</span>
      </div>
    </header>
    <article class="article-body">
      <slot />
    </article>
    <footer class="article-footer">
      <a class="text-link" href="/writing/">
        <span aria-hidden="true">←</span> All writing
      </a>
      <a class="text-link" href="#main">
        Top <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </main>
</BaseLayout>
