---
import ArticleRows from "../../components/ArticleRows.astro";
import Letterboxd from "../../components/Letterboxd.astro";
import backlog from "../../data/letterboxd-reviews.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { directedBy, film, loved, tmdbImage } from "../../lib/films";
import type { ReviewSource } from "../../lib/letterboxd";
import {
  formatDate,
  getPublishedPosts,
  isExternal,
  postHref,
  readingMinutes,
  topicFeedHref,
  topicPages,
  topics,
  type Topic,
} from "../../lib/posts";

interface Props {
  topic: Topic;
  intro: string;
  description: string;
}

export function getStaticPaths() {
  const pages = {
    cinema: {
      intro:
        "Film criticism, mostly in French: pieces published in Le Blog du Cinéma, essays, and my Letterboxd reviews.",
      description:
        "Film criticism by Aïmen Louafi, mostly in French: pieces published in Le Blog du Cinéma, essays, and reviews.",
    },
    tech: {
      intro: "Articles and papers on AI engineering. Most link to other sites.",
      description: "Articles and papers by Aïmen Louafi on AI engineering.",
    },
    notes: {
      intro: "Essays and notes on everything else.",
      description: "Essays and notes by Aïmen Louafi on everything else.",
    },
  } satisfies Record<Topic, { intro: string; description: string }>;

  return topics.map((topic) => ({
    params: { topic: topicPages[topic].slug },
    props: { topic, ...pages[topic] },
  }));
}

const { topic, intro, description } = Astro.props;
const { label } = topicPages[topic];
const posts = (await getPublishedPosts()).filter(
  (post) => post.data.topic === topic,
);
// The Cinema page separates pieces published by media outlets from essays
// on this site; other topics keep a single list.
const press = posts.filter((post) => isExternal(postHref(post)));
const essays = posts.filter((post) => !isExternal(postHref(post)));

// The latest press piece leads the Cinema page, with a still of its film.
const lead = press[0];
const leadFilm = film(lead?.data.film);
const leadStill = leadFilm?.backdrop;
const leadLoved =
  lead !== undefined &&
  (lead.data.favourite ||
    loved(
      (backlog as ReviewSource[]).find(
        (review) => review.slug === lead.data.film,
      )?.rating,
    ));

const feed = { title: `Aïmen Louafi — ${label}`, href: topicFeedHref(topic) };
---

<BaseLayout
  title={`${label} — Aïmen Louafi`}
  {description}
  current={topic}
  {feed}
>
  <main class="page" id="main">
    <header class:list={["page-head", { "has-visual": lead && leadStill }]}>
      <div class="page-head-text">
        <h1>{label}</h1>
        <p class="page-intro">
          {intro}
          {topic === "cinema" && (
            <>
              {" "}
              <a href="/cannes/">
                Find out more about my adventures at the Cannes Film
                Festival&nbsp;<span class="arrow">→</span>
              </a>
            </>
          )}
        </p>
      </div>
      {lead && leadStill && (
        <a class="feature" href={postHref(lead)} rel="noreferrer">
          <span class="feature-image">
            <img
              src={tmdbImage("w780", leadStill)}
              srcset={`${tmdbImage("w780", leadStill)} 780w, ${tmdbImage("w1280", leadStill)} 1280w`}
              sizes="(min-width: 62em) 34rem, 92vw"
              alt=""
              width="1280"
              height="720"
              fetchpriority="high"
            />
          </span>
          <span class="feature-label">
            Latest in {lead.data.publisher} <span class="arrow">↗</span>
          </span>
          <span class="feature-title" lang={lead.data.language}>
            {lead.data.title}
            {leadLoved && (
              <span class="row-heart" aria-hidden="true">
                ♥
              </span>
            )}
          </span>
          {(lead.data.director ?? directedBy(lead.data.film)) && (
            <span class="feature-meta">
              {lead.data.director ?? directedBy(lead.data.film)}
            </span>
          )}
        </a>
      )}
    </header>

    {topic === "cinema" ? (
      <>
        <section class="section" aria-labelledby="press-title">
          <header class="section-head">
            <h2 id="press-title">Published in the press</h2>
          </header>
          <ArticleRows posts={press} lang="en" />
        </section>

        {essays.length > 0 && (
          <section class="section" aria-labelledby="essays-title">
            <header class="section-head">
              <h2 id="essays-title">Essays</h2>
            </header>
            <ArticleRows posts={essays} lang="en" />
          </section>
        )}

        <Letterboxd />
      </>
    ) : posts.length > 0 ? (
      <ol class="post-list">
        {posts.map((post) => {
          const href = postHref(post);
          const external = isExternal(href);
          const isPdf = post.data.format === "paper" && href.endsWith(".pdf");
          return (
            <li>
              <a href={href} rel={external ? "noreferrer" : undefined}>
                <span class="post-title" lang={post.data.language}>
                  {post.data.title}
                </span>
                {post.data.authors && (
                  <span class="post-byline">
                    With {post.data.authors.slice(1).join(", ")}
                  </span>
                )}
                <span class="post-meta">
                  <time
                    datetime={post.data.publishedAt.toISOString()}
                    lang={post.data.language}
                  >
                    {formatDate(post)}
                  </time>
                  {" · "}
                  {post.data.publisher
                    ? `${post.data.publisher}${isPdf ? " (PDF)" : ""}${external ? " ↗" : ""}`
                    : external
                      ? "External ↗"
                      : `${readingMinutes(post.body)} min read`}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="empty-state">Nothing published here yet.</p>
    )}
  </main>
</BaseLayout>
