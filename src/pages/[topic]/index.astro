---
import ArticleRows from "../../components/ArticleRows.astro";
import Letterboxd from "../../components/Letterboxd.astro";
import backlog from "../../data/letterboxd-reviews.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDate,
  getPublishedPosts,
  isExternal,
  postHref,
  readingMinutes,
  topicFeedHref,
  topicPages,
  topics,
  type Topic,
} from "../../lib/posts";

interface Props {
  topic: Topic;
  roll: string;
  intro: string;
  description: string;
}

export function getStaticPaths() {
  const pages = {
    cinema: {
      intro:
        "Film criticism, mostly in French: pieces published in Le Blog du Cinéma, essays, and my Letterboxd reviews.",
      description:
        "Film criticism by Aïmen Louafi, mostly in French: pieces published in Le Blog du Cinéma, essays, and reviews.",
    },
    tech: {
      intro: "Articles and papers on AI engineering. Most link to other sites.",
      description: "Articles and papers by Aïmen Louafi on AI engineering.",
    },
    notes: {
      intro: "Essays and notes on everything else.",
      description: "Essays and notes by Aïmen Louafi on everything else.",
    },
  } satisfies Record<Topic, { intro: string; description: string }>;

  return topics.map((topic, index) => ({
    params: { topic: topicPages[topic].slug },
    props: {
      topic,
      roll: String(index + 2).padStart(2, "0"),
      ...pages[topic],
    },
  }));
}

const { topic, roll, intro, description } = Astro.props;
const { label } = topicPages[topic];
const posts = (await getPublishedPosts()).filter(
  (post) => post.data.topic === topic,
);
const languageLabels = { en: "English", fr: "Français" } as const;
// The Cinema page separates pieces published by media outlets from essays
// on this site; other topics keep a single list.
const press = posts.filter((post) => isExternal(postHref(post)));
const essays = posts.filter((post) => !isExternal(postHref(post)));
const outlets = [
  ...new Set(press.map((post) => post.data.publisher).filter(Boolean)),
];
const plural = (count: number, word: string) =>
  `${count} ${word}${count === 1 ? "" : "s"}`;
const feed = { title: `Aïmen Louafi — ${label}`, href: topicFeedHref(topic) };
---

<BaseLayout
  title={`${label} — Aïmen Louafi`}
  {description}
  current={topic}
  {feed}
>
  <main class="writing-main" id="main">
    <header class="writing-hero reveal">
      <p class="eyebrow">
        Roll {roll} / {label}
      </p>
      <h1>
        {label}
        <span class="accent-mark">.</span>
      </h1>
      <p class="writing-hero-copy">
        {intro}
        {topic === "cinema" && (
          <>
            <br />
            <a href="/cannes/">
              Find out more about my adventures at the Cannes Film Festival →
            </a>
          </>
        )}
      </p>
    </header>

    {topic === "cinema" ? (
      <>
        <section class="year-section" aria-labelledby="press-title">
          <header class="section-head">
            <h2 id="press-title">Published in the press</h2>
            <p class="year-meta">
              {[plural(press.length, "piece"), ...outlets].join(" · ")}
            </p>
          </header>
          <ArticleRows posts={press} lang="en" />
        </section>

        {essays.length > 0 && (
          <section class="year-section" aria-labelledby="essays-title">
            <header class="section-head">
              <h2 id="essays-title">Essays</h2>
              <p class="year-meta">{plural(essays.length, "essay")}</p>
            </header>
            <ArticleRows posts={essays} lang="en" />
          </section>
        )}

        <Letterboxd />

        <p class="post-count">
          {plural(press.length, "piece")} in the press ·{" "}
          {plural(essays.length, "essay")} ·{" "}
          <a href="/reviews/">{plural(backlog.length, "review")}</a> ·{" "}
          <a href={feed.href}>RSS</a>
        </p>
      </>
    ) : (
      <section class="writing-panel" aria-label={`${label} posts`}>
        {posts.length > 0 ? (
          <ol class="post-list">
            {posts.map((post) => {
              const href = postHref(post);
              const external = isExternal(href);
              const isPdf =
                post.data.format === "paper" && href.endsWith(".pdf");
              return (
                <li class="post-row reveal">
                  <time
                    class="post-date"
                    datetime={post.data.publishedAt.toISOString()}
                    lang={post.data.language}
                  >
                    {formatDate(post)}
                  </time>
                  <div class="post-heading">
                    <h2>
                      <a href={href} rel={external ? "noreferrer" : undefined}>
                        <span lang={post.data.language}>{post.data.title}</span>
                        {isPdf ? (
                          <span class="visually-hidden"> (PDF)</span>
                        ) : (
                          external && (
                            <span class="visually-hidden"> (external)</span>
                          )
                        )}
                      </a>
                    </h2>
                    {post.data.director && (
                      <p class="post-byline">
                        Directed by {post.data.director}
                      </p>
                    )}
                    {post.data.authors && (
                      <p class="post-byline">
                        With {post.data.authors.slice(1).join(", ")}
                      </p>
                    )}
                  </div>
                  <span class="post-tags">
                    {languageLabels[post.data.language]}
                  </span>
                  <span class="post-kind">
                    {post.data.publisher
                      ? `${post.data.publisher}${isPdf ? " · PDF →" : external ? " ↗" : ""}`
                      : external
                        ? "External ↗"
                        : `${readingMinutes(post.body)} min →`}
                  </span>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="empty-state">Nothing published here yet.</p>
        )}
        <p class="post-count">
          {posts.length} {posts.length === 1 ? "entry" : "entries"} ·{" "}
          <a href={feed.href}>RSS</a>
        </p>
      </section>
    )}
  </main>
</BaseLayout>
