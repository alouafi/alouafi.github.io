---
import ArticleRows from "../components/ArticleRows.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { getPublishedPosts, topicHref } from "../lib/posts";

const latest = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout current="home">
  <main class="page" id="main">
    <section class="intro" aria-labelledby="intro-title">
      <h1 id="intro-title">Aïmen Louafi</h1>
      <div class="intro-text">
        <p class="intro-lead">
          I’m an AI engineer at Mistral&nbsp;AI, and I write about{" "}
          <a href={topicHref("cinema")}>cinema</a>.
        </p>
        <p>
          I studied computer science and applied mathematics at Mines Paris, and
          spent a year at the University of Tokyo. Besides films, I’m into
          language learning, literature, and philosophy. I speak French,
          English, and Japanese (JLPT N1), as well as a little Spanish.
        </p>
        <p class="actions">
          <a class="btn btn-primary" href={topicHref("cinema")}>
            Read my film criticism
          </a>
          <a class="btn btn-secondary" href="/cannes/">
            See my Cannes Film Festival coverage
          </a>
        </p>
        <p class="intro-links">
          <a href={profile.links.linkedin} rel="me noreferrer">
            LinkedIn
          </a>
          <a href={profile.links.github} rel="me noreferrer">
            GitHub
          </a>
          <a href={profile.links.letterboxd} rel="me noreferrer">
            Letterboxd
          </a>
        </p>
      </div>
      <img
        class="portrait"
        src={profile.portrait}
        alt="Portrait of Aïmen Louafi"
        width="512"
        height="512"
      />
    </section>

    <section class="section" aria-labelledby="recent-title">
      <header class="section-head">
        <h2 id="recent-title">Recent writing</h2>
      </header>
      <ArticleRows posts={latest} lang="en" />
      <p class="actions">
        <a class="btn btn-primary" href={topicHref("cinema")}>
          Read my film criticism
        </a>
      </p>
    </section>
  </main>
</BaseLayout>
