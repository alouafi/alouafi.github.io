---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout current="home">
  <main class="home" id="main">
    <section class="intro film-strip" aria-labelledby="intro-title">
      <div class="perforations perforations-top" aria-hidden="true">
        {Array.from({ length: 12 }, () => (
          <i></i>
        ))}
      </div>

      <figure class="portrait film-frame">
        <div class="frame-code" aria-hidden="true">
          04
        </div>
        <div class="portrait-window">
          <img
            src={profile.portrait}
            alt="Portrait placeholder marked AL"
            width="640"
            height="800"
          />
          <span class="registration-mark" aria-hidden="true"></span>
        </div>
        <figcaption>
          <span>Frame 004</span>
          <span>Portrait to come</span>
        </figcaption>
      </figure>

      <div class="intro-copy film-frame">
        <div class="frame-meta" aria-hidden="true">
          <span>16 MM / FRAME 008</span>
          <span>48.8566° N · 2.3522° E</span>
        </div>
        <p class="eyebrow">Paris, France · 2026</p>
        <h1 id="intro-title">
          Aïmen Louafi<span class="accent-mark">.</span>
        </h1>
        <div class="intro-body">
          <p>
            I’m an AI engineer at Mistral AI. I studied computer science and
            applied mathematics at Mines Paris, and spent a year at the
            University of Tokyo.
          </p>
          <p>
            Outside work, I’m into cinema and language learning. I speak French
            and English, and passed the JLPT N1 in Japanese.
          </p>
        </div>
        <nav class="intro-links" aria-label="Profile links">
          <a href="/writing/">Writing</a>
          <a href={profile.links.linkedin} rel="me noreferrer">
            LinkedIn ↗
          </a>
          <a href={profile.links.github} rel="me noreferrer">
            GitHub ↗
          </a>
        </nav>
        <div class="frame-footer" aria-hidden="true">
          <span>AI / CINEMA / LANGUAGES</span>
          <span class="timecode">00:00:08:16</span>
        </div>
      </div>

      <div class="perforations perforations-bottom" aria-hidden="true">
        {Array.from({ length: 12 }, () => (
          <i></i>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
