---
import { getCollection } from "astro:content";
import WorkItem from "../components/WorkItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, selectedWork } from "../data/profile";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const latest = posts[0];
const latestHref = latest?.data.externalUrl ?? `/writing/${latest?.id}/`;
const topicLabels = {
  tech: "Technology",
  cinema: "Cinema",
  notes: "Site note",
} as const;
---

<BaseLayout current="home">
  <main class="home" id="main">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="eyebrow">AI engineer · Paris</p>
        <h1 id="intro-title">
          Hello, I’m
          <br />
          Aïmen Louafi<span class="accent-mark">.</span>
        </h1>
        <p class="intro-lede">
          I build AI systems that can be measured, debugged, and trusted.
        </p>
        <div class="intro-body">
          <p>
            I’m currently an AI Engineer at Mistral AI, working on agent
            reliability, evaluation, and the infrastructure behind production AI
            systems.
          </p>
          <p>
            My path into the field started with speech-recognition research at
            the University of Tokyo, then moved through fraud detection, legal
            search, and RAG. I’m most at home where applied mathematics meets
            useful software.
          </p>
        </div>
        <div class="intro-links">
          <a href={profile.links.linkedin} rel="me noreferrer">
            LinkedIn ↗
          </a>
          <a href={profile.links.github} rel="me noreferrer">
            GitHub ↗
          </a>
        </div>
      </div>

      <figure class="portrait">
        <img
          src={profile.portrait}
          alt="Portrait placeholder marked AL"
          width="640"
          height="800"
        />
        <figcaption>Portrait to come</figcaption>
      </figure>
    </section>

    <section class="home-section" id="work" aria-labelledby="work-title">
      <div class="home-section-heading">
        <h2 id="work-title">Selected work</h2>
        <p>A few threads from the last decade.</p>
      </div>
      <div class="work-list">
        {selectedWork.map((item) => (
          <WorkItem {item} />
        ))}
      </div>
    </section>

    {latest && (
      <section
        class="home-section writing-preview"
        aria-labelledby="writing-title"
      >
        <div class="home-section-heading">
          <h2 id="writing-title">Writing</h2>
          <p>
            Technical notes, films, and occasional digressions—in English or
            French.
          </p>
        </div>
        <article class="latest-post">
          <div>
            <p>
              {topicLabels[latest.data.topic]} ·{" "}
              {latest.data.language.toUpperCase()}
            </p>
            <h3>
              <a
                href={latestHref}
                rel={latest.data.externalUrl ? "noreferrer" : undefined}
              >
                {latest.data.title}
              </a>
            </h3>
            <p>{latest.data.description}</p>
          </div>
          <time datetime={latest.data.publishedAt.toISOString()}>
            {latest.data.publishedAt.toLocaleDateString("en-GB", {
              month: "short",
              year: "numeric",
            })}
          </time>
        </article>
        <a class="quiet-link" href="/writing/">
          Browse the notebook →
        </a>
      </section>
    )}
  </main>
</BaseLayout>
