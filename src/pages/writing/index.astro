---
// /writing/ used to list every post behind Work, Cinema, and Other tabs.
// Keep old links working by sending each tab's hash to its topic page.
import { topicHref } from "../../lib/posts";

const targets = {
  work: topicHref("tech"),
  cinema: topicHref("cinema"),
  other: topicHref("notes"),
};
const fallback = targets.work;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Redirecting… — Aïmen Louafi</title>
    <script is:inline define:vars={{ targets, fallback }}>
      location.replace(targets[location.hash.slice(1)] ?? fallback);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    </noscript>
  </head>
  <body>
    <p>
      Writing now lives under <a href={targets.cinema}>Cinema</a>,{" "}
      <a href={targets.work}>Tech</a>, and <a href={targets.other}>Other</a>.
    </p>
  </body>
</html>
