---
import films from "../data/films.json";
import backlog from "../data/letterboxd-reviews.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reviewHref, toReview, type ReviewSource } from "../lib/letterboxd";
import { getPublishedPosts, isExternal, postHref } from "../lib/posts";

// Films seen per edition are counted by hand: the Letterboxd diary also holds
// films watched at home during the festival, so it can't give an exact count.
const editions = [
  { year: 2026, number: 79, dates: "12 – 23 mai 2026", films: 35 },
  { year: 2025, number: 78, dates: "13 – 24 mai 2025", films: null },
  { year: 2024, number: 77, dates: "14 – 25 mai 2024", films: null },
];

const posts = await getPublishedPosts();
const reviews = (backlog as ReviewSource[]).map((source) => ({
  source,
  review: toReview(source),
}));

const sections = editions.map((edition) => ({
  ...edition,
  posts: posts.filter((post) => post.data.cannes === edition.year),
  // In the order the films were seen.
  reviews: reviews
    .filter(({ review }) => review.label === `Cannes ${edition.year}`)
    .sort(
      (a, b) =>
        (a.source.watchedDate ?? a.source.date).localeCompare(
          b.source.watchedDate ?? b.source.date,
        ) || a.source.title.localeCompare(b.source.title),
    ),
}));

const reviewCount = sections.reduce((n, s) => n + s.reviews.length, 0);
const postCount = sections.reduce((n, s) => n + s.posts.length, 0);
const latestFilms = sections.find((section) => section.films)?.films;
const photoAlt =
  "Aïmen Louafi en costume sombre et lunettes de soleil sur les marches rouges du Palais des Festivals, sous l’affiche de Cannes 2026";
// A heart marks the films rated 3.5 out of 5 or more.
const loved = (rating: number | null) => rating !== null && rating >= 3.5;
// Small TMDB posters; see npm run fetch:films.
const film = (slug: string | undefined) =>
  (
    films as Record<
      string,
      { poster?: string | null; directors?: string[] } | undefined
    >
  )[slug ?? ""];
const poster = (slug: string | undefined, size = "w92") => {
  const path = film(slug)?.poster;
  return path ? `https://image.tmdb.org/t/p/${size}${path}` : null;
};
const directorList = new Intl.ListFormat("fr", { type: "conjunction" });
const directedBy = (slug: string | undefined) => {
  const names = film(slug)?.directors ?? [];
  return names.length > 0 ? directorList.format(names) : null;
};
const fold = (title: string) =>
  title
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
// Published articles carry no rating or poster; they take them from the
// Letterboxd review of the same film in the same edition.
const articleReview = (title: string, reviews: { source: ReviewSource }[]) =>
  reviews.find(({ source }) => fold(source.title) === fold(title))?.source;
const lovedCount = (count: number) =>
  count > 0 && `${count} coup${count > 1 ? "s" : ""} de cœur`;
const plural = (count: number, word: string) =>
  `${count} ${word}${count > 1 ? "s" : ""}`;
---

<BaseLayout
  title="Cannes, 2024 – 2026 — Aïmen Louafi"
  description="Trois éditions du Festival de Cannes, de 2024 à 2026 : critiques, bilan et articles d’Aïmen Louafi."
  current="cinema"
  lang="fr"
  image="/assets/img/cannes/palais-2026-share.jpg"
  imageAlt={photoAlt}
>
  <main class="writing-main" id="main">
    <header class="writing-hero reveal">
      <p class="eyebrow">Festival de Cannes · 2024 – 2026</p>
      <h1>
        Cannes<span class="accent-mark">.</span>
      </h1>
      <p class="writing-hero-copy">
        Trois éditions du Festival, de 2024 à 2026, et ce que j’en ai écrit :
        des critiques sur place ou au retour, un bilan de l’édition 2026 et des
        articles pour Le Blog du Cinéma.
      </p>
    </header>

    <dl class="cannes-stats">
      <div>
        <dt>Éditions</dt>
        <dd>{sections.length}</dd>
      </div>
      <div>
        <dt>Critiques</dt>
        <dd>{reviewCount}</dd>
      </div>
      <div>
        <dt>Articles</dt>
        <dd>{postCount}</dd>
      </div>
      {latestFilms && (
        <div>
          <dt>Films vus en {sections[0]?.year}</dt>
          <dd>{latestFilms}</dd>
        </div>
      )}
    </dl>

    <figure class="still reveal">
      <div class="still-frame">
        <img
          src="/assets/img/cannes/palais-2026-1280.webp"
          srcset="/assets/img/cannes/palais-2026-800.webp 800w, /assets/img/cannes/palais-2026-1280.webp 1280w, /assets/img/cannes/palais-2026-2048.webp 2048w"
          sizes="(min-width: 1200px) 1024px, 92vw"
          alt={photoAlt}
          width="2048"
          height="1536"
          fetchpriority="high"
        />
        <span class="corner corner-tl" aria-hidden="true"></span>
        <span class="corner corner-tr" aria-hidden="true"></span>
        <span class="corner corner-bl" aria-hidden="true"></span>
        <span class="corner corner-br" aria-hidden="true"></span>
      </div>
      <figcaption>
        <span>Marches du Palais des Festivals</span>
        <span>18 mai 2026</span>
      </figcaption>
    </figure>

    {sections.map((edition) => (
      <section
        class="edition"
        id={`cannes-${edition.year}`}
        aria-labelledby={`cannes-${edition.year}-title`}
      >
        <header class="section-head">
          <h2 id={`cannes-${edition.year}-title`}>
            {edition.year}{" "}
            <span class="edition-number">
              {edition.number}
              <sup>e</sup> édition
            </span>
          </h2>
          <p class="edition-meta">
            {[
              edition.dates,
              edition.films && plural(edition.films, "film"),
              plural(edition.reviews.length, "critique"),
              lovedCount(
                edition.reviews.filter(({ source }) => loved(source.rating))
                  .length,
              ),
            ]
              .filter(Boolean)
              .join(" · ")}
          </p>
        </header>

        {edition.posts.length > 0 && (
          <ul class="edition-posts">
            {edition.posts.map((post) => {
              const href = postHref(post);
              const external = isExternal(href);
              const review = articleReview(post.data.title, edition.reviews);
              const image = post.data.poster ?? poster(review?.slug, "w154");
              return (
                <li>
                  <span class="edition-poster">
                    {image && (
                      <img
                        src={image}
                        alt=""
                        width="154"
                        height="231"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                  <div class="edition-film">
                    <a href={href} rel={external ? "noreferrer" : undefined}>
                      {post.data.title}
                      {loved(review?.rating ?? null) && (
                        <>
                          <span class="edition-heart" aria-hidden="true">
                            ♥
                          </span>
                          <span class="visually-hidden">, coup de cœur</span>
                        </>
                      )}
                    </a>
                    {post.data.director && (
                      <span class="edition-director">{post.data.director}</span>
                    )}
                  </div>
                  <span class="edition-source">
                    {post.data.publisher
                      ? `${post.data.publisher} ↗`
                      : "Lire le bilan →"}
                  </span>
                </li>
              );
            })}
          </ul>
        )}

        <ol class="edition-reviews">
          {edition.reviews.map(({ source, review }) => (
            <li>
              <span class="edition-poster">
                {poster(source.slug) && (
                  <img
                    src={poster(source.slug)}
                    alt=""
                    width="92"
                    height="138"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
              <div class="edition-film">
                <a href={reviewHref(review)}>
                  {source.title}
                  {loved(source.rating) && (
                    <>
                      <span class="edition-heart" aria-hidden="true">
                        ♥
                      </span>
                      <span class="visually-hidden">, coup de cœur</span>
                    </>
                  )}
                </a>
                {directedBy(source.slug) && (
                  <span class="edition-director">
                    {directedBy(source.slug)}
                  </span>
                )}
              </div>
              <span class="edition-read" aria-hidden="true">
                Lire<span class="edition-read-long"> la critique</span> →
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</BaseLayout>
