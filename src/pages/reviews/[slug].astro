---
import backlog from "../../data/letterboxd-reviews.json";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
  reviewHtml,
  stars,
  toReview,
  type ReviewSource,
} from "../../lib/letterboxd";
import { directedBy, film, tmdbImage } from "../../lib/films";
import { readingMinutes } from "../../lib/posts";

interface Props {
  source: ReviewSource;
}

export function getStaticPaths() {
  return (backlog as ReviewSource[]).map((source) => ({
    params: { slug: source.slug ?? "" },
    props: { source },
  }));
}

const { source } = Astro.props;
const review = toReview(source);
const edition = review.label?.match(/^Cannes (\d{4})$/)?.[1];

// Film stills and posters come from TMDB; see npm run fetch:films.
const info = film(source.slug);
const french = review.lang === "fr";
const still = info?.backdrop
  ? {
      kind: "backdrop",
      src: tmdbImage("w1280", info.backdrop),
      srcset: `${tmdbImage("w780", info.backdrop)} 780w, ${tmdbImage("w1280", info.backdrop)} 1280w`,
      sizes: "(min-width: 1100px) 1040px, 92vw",
      width: 1280,
      height: 720,
      alt: french
        ? `Image du film ${source.title}`
        : `Still from ${source.title}`,
    }
  : info?.poster
    ? {
        kind: "poster",
        src: tmdbImage("w500", info.poster),
        srcset: `${tmdbImage("w342", info.poster)} 342w, ${tmdbImage("w500", info.poster)} 500w`,
        sizes: "22rem",
        width: 500,
        height: 750,
        alt: french
          ? `Affiche du film ${source.title}`
          : `Poster for ${source.title}`,
      }
    : null;
// "Director · year" under the title.
const deck = [directedBy(source.slug), source.year].filter(Boolean).join(" · ");
---

<ArticleLayout
  title={source.title}
  description={
    review.excerpt ||
    `Review of ${source.title} (${source.year}) by Aïmen Louafi.`
  }
  publishedAt={new Date(source.date)}
  language={review.lang}
  topic="cinema"
  section="reviews"
  minutes={readingMinutes(source.text)}
  deck={deck}
  details={
    source.rating === null
      ? []
      : [
          {
            value: stars(source.rating),
            spoken: french
              ? `Noté ${String(source.rating).replace(".", ",")} sur 5`
              : `Rated ${source.rating} out of 5`,
          },
        ]
  }
  cover={still ? { src: still.src, alt: still.alt } : undefined}
  back={
    edition
      ? { href: `/cannes/#cannes-${edition}`, label: `Cannes ${edition}` }
      : { href: "/reviews/", label: "Reviews" }
  }
>
  {still && (
    <figure
      slot="lead"
      class:list={["still", { "still-poster": still.kind === "poster" }]}
    >
      <img
        src={still.src}
        srcset={still.srcset}
        sizes={still.sizes}
        alt={still.alt}
        width={still.width}
        height={still.height}
        fetchpriority="high"
      />
    </figure>
  )}
  <Fragment set:html={reviewHtml(source.text)} />
  <p class="review-source">
    <a href={source.url} rel="noreferrer">
      {french
        ? "Publiée d’abord sur Letterboxd ↗"
        : "First published on Letterboxd ↗"}
    </a>
  </p>
</ArticleLayout>
