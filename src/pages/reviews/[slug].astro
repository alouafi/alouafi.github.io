---
import films from "../../data/films.json";
import backlog from "../../data/letterboxd-reviews.json";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
  reviewHtml,
  stars,
  toReview,
  type ReviewSource,
} from "../../lib/letterboxd";
import { readingMinutes } from "../../lib/posts";

interface Props {
  source: ReviewSource;
}

export function getStaticPaths() {
  return (backlog as ReviewSource[]).map((source) => ({
    params: { slug: source.slug ?? "" },
    props: { source },
  }));
}

const { source } = Astro.props;
const review = toReview(source);
const edition = review.label?.match(/^Cannes (\d{4})$/)?.[1];

// Film stills and posters come from TMDB; see npm run fetch:films.
const images = (
  films as Record<
    string,
    { backdrop?: string | null; poster?: string | null } | undefined
  >
)[source.slug ?? ""];
const tmdb = (size: string, path: string) =>
  `https://image.tmdb.org/t/p/${size}${path}`;
const french = review.lang === "fr";
const still = images?.backdrop
  ? {
      kind: "backdrop",
      src: tmdb("w1280", images.backdrop),
      srcset: `${tmdb("w780", images.backdrop)} 780w, ${tmdb("w1280", images.backdrop)} 1280w`,
      sizes: "(min-width: 1100px) 60rem, 92vw",
      width: 1280,
      height: 720,
      alt: french
        ? `Image du film ${source.title}`
        : `Still from ${source.title}`,
    }
  : images?.poster
    ? {
        kind: "poster",
        src: tmdb("w500", images.poster),
        srcset: `${tmdb("w342", images.poster)} 342w, ${tmdb("w500", images.poster)} 500w`,
        sizes: "22rem",
        width: 500,
        height: 750,
        alt: french
          ? `Affiche du film ${source.title}`
          : `Poster for ${source.title}`,
      }
    : null;
---

<ArticleLayout
  title={source.title}
  description={
    review.excerpt ||
    `Review of ${source.title} (${source.year}) by Aïmen Louafi.`
  }
  publishedAt={new Date(source.date)}
  language={review.lang}
  topic="cinema"
  format="post"
  minutes={readingMinutes(source.text)}
  eyebrow={`${review.label ?? "Cinema"} · Review`}
  deck={null}
  dateLabel="Reviewed"
  details={[
    { label: "Film", value: source.year },
    ...(source.rating === null
      ? []
      : [
          {
            label: "Rating",
            value: stars(source.rating),
            spoken: `${source.rating} out of 5`,
          },
        ]),
  ]}
  cover={still ? { src: still.src, alt: still.alt } : undefined}
  back={
    edition
      ? { href: `/cannes/#cannes-${edition}`, label: `Cannes ${edition}` }
      : undefined
  }
>
  {still && (
    <figure
      slot="lead"
      class:list={[
        "still article-lead reveal",
        { "still-poster": still.kind === "poster" },
      ]}
    >
      <div class="still-frame">
        <img
          src={still.src}
          srcset={still.srcset}
          sizes={still.sizes}
          alt={still.alt}
          width={still.width}
          height={still.height}
          fetchpriority="high"
        />
        <span class="corner corner-tl" aria-hidden="true" />
        <span class="corner corner-tr" aria-hidden="true" />
        <span class="corner corner-bl" aria-hidden="true" />
        <span class="corner corner-br" aria-hidden="true" />
      </div>
      <figcaption>
        <span>
          {source.title} · {source.year}
        </span>
        <span>{still.kind === "backdrop" ? "Still" : "Poster"} · TMDB</span>
      </figcaption>
    </figure>
  )}
  <Fragment set:html={reviewHtml(source.text)} />
  <p class="review-source">
    <a href={source.url} rel="noreferrer">
      First published on Letterboxd ↗
    </a>
  </p>
</ArticleLayout>
