---
import ReviewRows from "../../components/ReviewRows.astro";
import backlog from "../../data/letterboxd-reviews.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loved, posterUrl } from "../../lib/films";
import { reviewHref, toReview, type ReviewSource } from "../../lib/letterboxd";

// Newest first, grouped by the year each review was written.
const reviews = (backlog as ReviewSource[])
  .map((source) => ({ source, review: toReview(source) }))
  .sort(
    (a, b) =>
      b.source.date.localeCompare(a.source.date) ||
      a.source.title.localeCompare(b.source.title),
  );
const years = [
  ...new Set(reviews.map(({ source }) => source.date.slice(0, 4))),
];
const byYear = years.map((year) => ({
  year,
  items: reviews.filter(({ source }) => source.date.startsWith(year)),
}));
const lovedCount = (items: typeof reviews) =>
  items.filter(({ source }) => loved(source.rating)).length;
// The six most recent films I loved, as a wall of posters.
const wall = reviews
  .filter(({ source }) => loved(source.rating) && posterUrl(source.slug))
  .slice(0, 6);
---

<BaseLayout
  title="Reviews — Aïmen Louafi"
  description={`${reviews.length} film reviews by Aïmen Louafi, mostly in French, from ${years.at(-1)} to ${years[0]}.`}
  current="reviews"
>
  <main class="page" id="main">
    <header class="page-head has-visual">
      <div class="page-head-text">
        <h1>Reviews</h1>
        <p class="page-intro">
          All {reviews.length} reviews I’ve written on Letterboxd since{" "}
          {years.at(-1)}, most of them in French. A heart marks the{" "}
          {lovedCount(reviews)} films I rated 3.5 out of 5 or more.
        </p>
      </div>
      <ul class="poster-wall">
        {wall.map(({ source, review }) => (
          <li>
            <a href={reviewHref(review)}>
              <img
                src={posterUrl(source.slug, "w342")}
                alt={`${source.title}, read the review`}
                width="342"
                height="513"
              />
            </a>
          </li>
        ))}
      </ul>
    </header>

    {byYear.map(({ year, items }) => (
      <section
        class="section"
        id={`reviews-${year}`}
        aria-labelledby={`reviews-${year}-title`}
      >
        <header class="section-head">
          <h2 id={`reviews-${year}-title`}>{year}</h2>
        </header>
        <ReviewRows items={items} lang="en" showLabels />
      </section>
    ))}
  </main>
</BaseLayout>
